  class Note0 {
    "All concrete commands are composed of one IRCDto, so a composition relation should be assumed between all concrete commands and the IRCDto class"
  }
  class Note1 {
    "All commands must be created using the CommandFactory class and the caller owns the new command and is responsible for its destruction"
  }
  class Note2 {
